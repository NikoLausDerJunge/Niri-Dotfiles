configuration {
    display-drun: " ";
    font: "Iosevka Term 11";
    show-icons: true; // Icons Enabled
    drun-display-format: "{name}"; // For Only Namev
}

entry {
    placeholder: ""; // Input Box Placeholder
}

* {
    background:                  rgba(39, 50, 56, 0.0);
    foreground:                  rgba(193, 193, 193, 1.0);

    selected-normal-foreground:  rgba(255, 255, 255, 1.0);
    normal-foreground:           @foreground;
    selected-urgent-foreground:  rgba(255, 24, 68, 1.0);
    urgent-foreground:           rgba(255, 24, 68, 1.0);
    active-foreground:           rgba(128, 203, 196, 1.0);
    selected-active-foreground:  rgba(128, 203, 196, 1.0);

    selected-normal-background:  rgba(128, 127, 127, 0.27);
    selected-urgent-background:  rgba(57, 66, 73, 0.8);

    spacing:                     0;
    separatorcolor:              rgba(30, 37, 41, 0);
}

window {
    width: 500px;
    height: 450px;
    transparency: "real"; // For Real transparency
    background-color: rgba(33, 33, 33, 0.39);
    border-color: rgba(142, 142, 142, 0.39);
    border: 2; // No Border
    padding: 15;
    border-radius: 15px;

    location: north;
    anchor: north;
    y-offset: 11px;
}

mainbox {
    border: 0;
    padding: 0;
}

textbox {
    text-color: @foreground;
}

prompt {
    vertical-align: 2;
}

listview {
    lines: 10;
    fixed-height: 0;
    scrollbar: false;
    spacing: 0;
    padding: 0;
}

element-icon {
    size: 22px;
}

element {
    border: 0;
    padding: 12px;
    spacing: 10px;
    background-color: transparent;
    border-radius: 10px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}

element.normal.normal {
    background-color: transparent;
    text-color: @normal-foreground;
}

element.normal.urgent {
    background-color: transparent;
    text-color: @urgent-foreground;
}

element.normal.active {
    background-color: transparent;
    text-color: @active-foreground;
}

element.selected.normal {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
}

element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color: @selected-urgent-foreground;
}

element.selected.active {
    background-color: rgba(128, 203, 196, 0.3);
    text-color: @selected-active-foreground;
}

element.alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element.alternate.urgent {
    background-color: transparent;
    text-color: @urgent-foreground;
}

element.alternate.active {
    background-color: transparent;
    text-color: @active-foreground;
}

button.selected {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
}

inputbar {
    spacing: 0;
    text-color: @normal-foreground;
    padding: 12px;
    background-color: transparent;
}

inputbar {
    children: [ prompt, textbox-prompt-colon, entry, case-indicator ];
}

textbox-prompt-colon {
    expand: false;
    str: "";
    margin: 0px 0.3em 0em 0em;
    text-color: @normal-foreground;
}
