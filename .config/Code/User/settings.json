{
// Workbench
  "workbench.activityBar.location": "hidden",
  "workbench.editor.showTabs": "single",
  "workbench.statusBar.visible": false,
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.sideBar.location": "right",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.tree.enableStickyScroll": false,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.tree.indent": 28,
  "workbench.editor.labelFormat": "short",
  "workbench.editor.showIcons": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.welcomePage.experimentalOnboarding": false,
  "workbench.experimental.modernUI": false,

// Hides Explorer Arrow
  "material-icon-theme.hidesExplorerArrows": true,

// Explorer
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "explorer.decorations.badges": false,
  "explorer.openEditors.visible": 1,
  "explorer.autoReveal": true,

// Git
  "git.decorations.enabled": false,

// Window
  "window.zoomLevel": 3,
  "window.customTitleBarVisibility": "never",
  "window.titleBarStyle": "native",
  "window.menuBarVisibility": "hidden",

// Breadcrumbs
  "breadcrumbs.enabled": false,

// Chat
  "chat.viewSessions.enabled": false,
  "chat.contextUsage.enabled": false,
  "chat.welcomePage.signIn.enabled": false,
  "chat.agent.enabled": false,

// Editor
  "editor.mouseWheelZoom": true,
  "editor.smoothScrolling": true,
  "editor.stickyScroll.enabled": false,
  "editor.stickyScroll.scrollWithEditor": false,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorWidth": 4,
  "editor.cursorBlinking": "solid",
  "editor.cursorStyle": "line",
  "editor.fontWeight": "450",
  "editor.lineHeight": 1.7,
  "editor.padding.bottom": 20,
  "editor.padding.top": 20,
  "editor.lineNumbers": "on",
  "editor.minimap.enabled": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.overviewRulerBorder": false,
  "editor.scrollbar.vertical": "hidden",
  // Lines between Spaces
  "editor.guides.indentation": false,

// Terminal
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.fontFamily": "CaskaydiaCove Nerd Font, Consolas, 'Courier New', monospace",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.fontWeight": "380",
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.suggest.enabled": true,
  "terminal.integrated.defaultProfile.windows": "Command Prompt",

// Custom CSS Import
  "vscode_custom_css.imports": [
    "file:///C:/Users/07m/AppData/Roaming/Code/User/test.css"
  ],

// Workbench Color Customizations
  "workbench.colorCustomizations": {
    "quickInput.background": "#181818CC",
    "quickInput.foreground": "#C8C8C8",

    "quickInputList.focusBackground": "#FFFFFF0D",
    "quickInputList.focusHighlightForeground": "#FFFFFF",

    "quickInputTitle.background": "#FFFFFF08",
    "quickInputList.focusIconForeground": "#777777",

    "input.background": "#FFFFFF08",
    "input.border": "#FFFFFF12",

    "scrollbar.background": "#FFFFFF05"
  },
  "workbench.colorTheme": "Bearded Theme HC Ebony"
}
