{
  "layer": "top",
  "position": "top",

  "modules-left": [
    "clock",
    "niri/window"
  ],

  "modules-center": [
    "niri/workspaces"
  ],

  "group/audio": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 650,
      "transition-left-to-right": false
    },
    "modules": [
      "pulseaudio",
      "pulseaudio/slider"
    ]
  },

  "modules-right": [
    "tray",
    "group/audio",
    "memory",
    "cpu",
    "network",
    "custom/notifications"
  ],

  "network": {
    "format-wifi": "Wifi",
    "format-ethernet": "Lan",
    "format-disconnected": "Disconnected"
  }, 

  "tray": {
    "spacing": 8,
    "icon-size": 15,
    "tooltip": false
  },

  "niri/window": {
      "format": "{title}",
      "separate-outputs": true,
      "max-length": 20,
      "icon": true,
      "icon-size": 15,
      "tooltip": false
  },

  "clock": {
    "format": "{:%H:%M  %a %d.%m}",
    "tooltip": false
  },

  "cpu": {
    "format": "    {usage:02}%",
    "tooltip": false,
    "interval": 10
  },

  "memory": {
    "format": "    {used:0.1f}G",
    "tooltip": false,
    "interval": 10
  },

  "pulseaudio": {
    "format": " {icon} ",
    "format-muted": "",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋋",
      "hands-free": "󰋋",
      "default": [
        "",
        "",
        ""
      ]
    },
    "tooltip": false
  },

  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
    "show-value": false
  }
}
